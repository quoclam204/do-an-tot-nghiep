{
  "expo": {
    "name": "DalatAgri",
    "slug": "dalat-agri-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#15803d",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dalatagri.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15803d"
      },
      "package": "com.dalatagri.mobile"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
