generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  WORKER
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique
  phone                String?   @unique
  passwordHash         String
  fullName             String
  role                 UserRole  @default(OWNER)
  isActive             Boolean   @default(true)
  approvalStatus       String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  rejectionReason      String?
  emailVerified        Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  farms                Farm[]
  farmMemberships      FarmMember[]
  refreshTokens        RefreshToken[]
  
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
}

model FarmMember {
  id                  String   @id @default(uuid()) @db.Uuid
  farmId              String   @db.Uuid
  userId              String   @db.Uuid
  role                String   @default("WORKER") // OWNER, MANAGER, WORKER
  canEditLog          Boolean  @default(true)
  canManageInventory  Boolean  @default(true)
  joinedAt            DateTime @default(now())

  farm                Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([farmId])
  @@index([userId])
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  token       String    @unique
  deviceInfo  String?   // để biết đăng nhập từ thiết bị nào (hữu ích cho app mobile/PWA)
  expiresAt   DateTime
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  location  String
  totalArea Float

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user           User           @relation(fields: [userId], references: [id])
  members        FarmMember[]
  plots          Plot[]
  inventories    Inventory[]
  products       Product[]
  invoices       Invoice[]
  activityTypes  ActivityType[]
}

model Plot {
  id            String    @id @default(uuid()) @db.Uuid
  farmId        String    @db.Uuid
  name          String
  area          Float

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  farm          Farm      @relation(fields: [farmId], references: [id])
  cropCycles    CropCycle[]
}

model Crop {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  type          String

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  cropCycles    CropCycle[]
  growthCycles  GrowthCycle[]
}

model GrowthCycle {
  id                String   @id @default(uuid()) @db.Uuid
  cropId            String   @db.Uuid
  name              String
  description       String?
  isActive          Boolean  @default(true)
  totalDurationDays Int?     // Tổng số ngày chu kỳ (tự tính từ tổng các stages)
  yearsToFlower     Float?   // Số năm để cây ra hoa (VD: Sầu riêng = 4-5 năm)
  yearsToHarvest    Float?   // Số năm để cây cho thu hoạch đầu tiên
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  crop        Crop          @relation(fields: [cropId], references: [id])
  stages      GrowthStage[]
  cropSeasons CropCycle[]
}

model GrowthStage {
  id                  String   @id @default(uuid()) @db.Uuid
  growthCycleId       String   @db.Uuid
  name                String
  sequence            Int
  durationDays        Int
  description         String?
  suggestedActivities String?  // Gợi ý hoạt động nên làm ở giai đoạn này (VD: "Bón phân, Tưới nước, Cắt tỉa")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  growthCycle GrowthCycle @relation(fields: [growthCycleId], references: [id])

  @@unique([growthCycleId, sequence])
}

model CropCycle {
  id                String    @id @default(uuid()) @db.Uuid
  plotId            String    @db.Uuid
  cropId            String    @db.Uuid
  growthCycleId     String?   @db.Uuid
  name              String
  startDate         DateTime
  expectedEndDate   DateTime
  actualEndDate     DateTime?
  status            String
  isIntercropped    Boolean   @default(false) // Trồng xen canh trên cùng lô đất
  totalYield        Float?    // Tổng sản lượng thu hoạch được của vụ này

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  plot              Plot        @relation(fields: [plotId], references: [id])
  crop              Crop        @relation(fields: [cropId], references: [id])
  growthCycle       GrowthCycle? @relation(fields: [growthCycleId], references: [id])
  activityLogs      ActivityLog[]
}

model Material {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  type          String    @default("PHAN_BON") // PHAN_BON, THUOC_BVTV, GIONG, KHAC
  unit          String
  defaultPrice  Float

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  inventories       Inventory[]
  activityMaterials ActivityMaterial[]
  histories         MaterialHistory[]
}

// Lịch sử thay đổi vật tư - giữ lại dữ liệu khi sửa/xóa vật tư
model MaterialHistory {
  id            String    @id @default(uuid()) @db.Uuid
  materialId    String    @db.Uuid
  name          String    // Tên vật tư tại thời điểm thay đổi
  type          String
  unit          String
  defaultPrice  Float
  action        String    // CREATE, UPDATE, DELETE
  changedBy     String?   // userId người thực hiện thay đổi
  changedAt     DateTime  @default(now())

  material      Material  @relation(fields: [materialId], references: [id])

  @@index([materialId])
}

model Inventory {
  id            String    @id @default(uuid()) @db.Uuid
  farmId        String    @db.Uuid
  materialId    String    @db.Uuid
  quantity      Float
  totalCost     Float

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  farm          Farm      @relation(fields: [farmId], references: [id])
  material      Material  @relation(fields: [materialId], references: [id])
}

// Loại hoạt động canh tác - cho phép nông hộ tự thêm/sửa/xóa linh hoạt
model ActivityType {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    // VD: BON_PHAN, PHUN_THUOC, CAT_TIA, LAM_CO, TUOI_NUOC, THU_HOACH
  name        String    // VD: "Bón phân", "Phun thuốc", "Cắt tỉa"
  description String?
  icon        String?   // Tên icon (VD: "leaf", "flask", "scissors")
  isSystem    Boolean   @default(false) // Loại mặc định không xóa được
  farmId      String?   @db.Uuid        // null = global (hệ thống), có farmId = riêng nông hộ

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  farm        Farm?     @relation(fields: [farmId], references: [id])

  @@index([farmId])
  @@index([code])
}

model ActivityLog {
  id              String    @id @default(uuid()) @db.Uuid
  cropCycleId     String    @db.Uuid
  activityType    String    // VD: LAM_DAT, TUOI, BON_PHAN, PHUN_THUOC, THU_HOACH...
  activityDate    DateTime
  activityTime    String?   // Giờ thực hiện: VD "08:30", "14:00"
  workShift       String?   // Ca làm việc: SANG, CHIEU, TOI
  notes           String?
  syncStatus      String    // VD: PENDING, SYNCED, CONFLICT

  // Quản lý chi phí nhân công (tự làm hay thuê ngoài)
  isHiredLabor    Boolean   @default(false)
  laborWorkers    Int?      // Số nhân công thuê
  laborWagePerDay Float?    // Tiền công trên mỗi nhân công / ngày
  laborCost       Float?    // Tổng tiền nhân công = laborWorkers * laborWagePerDay

  // Chi phí máy móc / phát sinh khác
  otherCosts      Float?

  // Tổng chi phí của hoạt động = laborCost + otherCosts + tổng chi phí vật tư
  cost            Float?
  
  // Dành riêng cho loại hình THU_HOACH
  harvestQuantity Float?    // Sản lượng thu được trong lần thu hoạch này (kg)
  unitPrice       Float?    // Đơn giá bán (VNĐ/kg)
  revenue         Float?    // Doanh thu ước tính/thực tế của đợt thu hoạch

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt     DateTime?

  cropCycle       CropCycle          @relation(fields: [cropCycleId], references: [id])
  materials       ActivityMaterial[]
}

// Bảng trung gian để 1 hoạt động có thể dùng nhiều loại vật tư (VD: pha 2 loại phân bón)
model ActivityMaterial {
  id              String    @id @default(uuid()) @db.Uuid
  activityLogId   String    @db.Uuid
  materialId      String    @db.Uuid
  materialName    String?   // Snapshot tên vật tư tại thời điểm sử dụng
  unit            String?   // Snapshot đơn vị
  unitPrice       Float?    // Snapshot đơn giá
  quantityUsed    Float
  cost            Float     // Chi phí vật tư (quantityUsed * đơn giá)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt     DateTime?

  activityLog     ActivityLog @relation(fields: [activityLogId], references: [id])
  material        Material    @relation(fields: [materialId], references: [id])
}

// ==================== HỆ THỐNG BÁN HÀNG & HÓA ĐƠN ====================

// Sản phẩm / nông sản bán ra
model Product {
  id              String    @id @default(uuid()) @db.Uuid
  farmId          String    @db.Uuid
  name            String    // VD: "Cà phê nhân sống", "Bơ 034 loại 1"
  unit            String    // VD: "kg", "trái", "bao"
  price           Float     // Đơn giá bán
  stockQuantity   Float     @default(0) // Số lượng tồn kho hiện tại
  description     String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  farm            Farm          @relation(fields: [farmId], references: [id])
  invoiceItems    InvoiceItem[]
}

// Hóa đơn bán hàng
model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  farmId          String    @db.Uuid
  invoiceNumber   String    @unique // Mã hóa đơn tự sinh: VD "HD-20260915-001"
  customerName    String?   // Tên khách hàng
  customerPhone   String?   // SĐT khách hàng
  customerAddress String?   // Địa chỉ khách hàng
  totalAmount     Float     @default(0) // Tổng tiền hóa đơn
  discount        Float     @default(0) // Giảm giá
  finalAmount     Float     @default(0) // Thành tiền = totalAmount - discount
  notes           String?
  status          String    @default("DRAFT") // DRAFT, COMPLETED, CANCELLED

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  farm            Farm          @relation(fields: [farmId], references: [id])
  items           InvoiceItem[]
}

// Chi tiết hóa đơn
model InvoiceItem {
  id              String    @id @default(uuid()) @db.Uuid
  invoiceId       String    @db.Uuid
  productId       String    @db.Uuid
  productName     String    // Lưu tên sản phẩm tại thời điểm bán (snapshot)
  quantity        Float
  unitPrice       Float     // Đơn giá tại thời điểm bán
  subtotal        Float     // = quantity * unitPrice

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}
