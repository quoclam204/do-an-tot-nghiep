DATABASE_URL="postgresql://postgres:password123@localhost:5433/dalat_agri?schema=public"
JWT_SECRET="change-this-development-secret"
PORT=3000

# Google OAuth Configuration (Client ID từ Google Cloud Console)
GOOGLE_CLIENT_ID=

# Khuyên dùng khi Deploy lên Render Free Tier (tránh Render chặn cổng SMTP):
# Đăng ký miễn phí tại https://resend.com lấy API Key
RESEND_API_KEY=

# Hoặc dùng SMTP Gmail (chỉ chạy tốt ở local):
EMAIL_USER=
EMAIL_PASS=
FRONTEND_URL=https://dalatagri.vercel.app
